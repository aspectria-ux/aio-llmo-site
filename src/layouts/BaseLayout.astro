---
// 全ページ共通のレイアウト
// title, description は各ページから渡す
// jsonLd には、そのページ用のJSON-LD構造化データ(オブジェクト or 配列)を渡せる
export interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
}

const { title, description, jsonLd } = Astro.props;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url.href} />

    {jsonLdList.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <header>
      <nav>
        <a href="/">aio.tipsindex.net</a>
        <a href="/articles/">記事一覧</a>
        <a href="/log/">施策ログ</a>
        <a href="/about/">運営者について</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 aio.tipsindex.net — AIO/LLMO実践記録</p>
    </footer>
  </body>
</html>

<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", sans-serif;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
    line-height: 1.8;
    color: #222;
  }
  header nav {
    display: flex;
    gap: 1.2rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid #eee;
    margin-bottom: 2rem;
  }
  header nav a {
    color: #1F4E78;
    text-decoration: none;
    font-size: 0.95rem;
  }
  header nav a:first-child {
    font-weight: bold;
  }
  footer {
    margin-top: 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid #eee;
    color: #888;
    font-size: 0.85rem;
  }
  h1 { font-size: 1.7rem; }
  h2 { font-size: 1.3rem; margin-top: 2rem; }
</style>
