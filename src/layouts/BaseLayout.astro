---
// 全ページ共通のレイアウト
// title, description は各ページから渡す
// jsonLd には、そのページ用のJSON-LD構造化データ(オブジェクト or 配列)を渡せる
export interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
}

const { title, description, jsonLd } = Astro.props;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const SITE_NAME = "AIO Field Notes";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="bfc8zBrWAVY27_1WLEL0qiR6rekmSzNxwOSb4Gl9Pfg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content={SITE_NAME} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@500;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {jsonLdList.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">AIO</span>
          <span class="brand-name">{SITE_NAME}</span>
        </a>
        <nav>
          <a href="/articles/">Article</a>
          <a href="/log/">Log</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-links"><a href="/about/">運営者について</a></div>
      <p>&copy; 2026 {SITE_NAME}(aio.tipsindex.net) — AIO/LLMO実践記録</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --ink: #333333;
    --navy: #16233f;
    --navy-soft: #3c5075;
    --rule: #e4e2db;
    --paper: #fdfcf9;
  }

  html {
    background: var(--paper);
  }

  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Hiragino Sans", sans-serif;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.75rem;
    line-height: 1.85;
    color: var(--ink);
    background: var(--paper);
  }

  header {
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1.6rem 0 1.3rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--navy);
  }

  .brand-mark {
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    border: 1px solid var(--navy);
    padding: 0.05rem 0.4rem;
  }

  .brand-name {
    font-family: "Noto Serif JP", serif;
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  header nav {
    display: flex;
    gap: 1.4rem;
  }

  header nav a {
    color: var(--navy-soft);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  header nav a:hover {
    color: var(--navy);
    border-bottom: 1px solid var(--navy);
  }

  main {
    min-height: 60vh;
  }

  footer {
    margin-top: 4rem;
    padding: 1.75rem 0 3rem;
    border-top: 1px solid var(--rule);
    color: #8a8778;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
  }

  .footer-links {
    margin-bottom: 0.6rem;
  }

  .footer-links a {
    font-size: 0.72rem;
    color: #a19d8c;
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .footer-links a:hover {
    color: var(--navy-soft);
  }

  h1 {
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    font-size: 1.85rem;
    letter-spacing: 0.01em;
    line-height: 1.5;
    margin-bottom: 1.4rem;
    color: var(--navy);
  }

  h2 {
    font-family: "Noto Serif JP", serif;
    font-weight: 500;
    font-size: 1.25rem;
    margin-top: 2.6rem;
    margin-bottom: 1rem;
    color: var(--navy);
    border-left: 3px solid var(--navy);
    padding-left: 0.7rem;
  }

  p, li {
    font-size: 0.98rem;
  }

  a {
    color: var(--navy-soft);
  }

  a:hover {
    color: var(--navy);
  }

  strong {
    color: var(--navy);
  }

  ul, ol {
    padding-left: 1.3rem;
  }

  li + li {
    margin-top: 0.5rem;
  }

  code {
    background: #f0efe9;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-size: 0.88em;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  caption {
    caption-side: bottom;
    text-align: left;
    font-size: 0.78rem;
    color: #8a8778;
    margin-top: 0.6rem;
  }

  th, td {
    text-align: left;
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  th {
    font-family: "Noto Serif JP", serif;
    font-weight: 500;
    color: var(--navy);
    border-bottom: 2px solid var(--navy);
  }
</style>
