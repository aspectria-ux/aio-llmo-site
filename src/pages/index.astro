---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AIO Field Notes",
  "url": "https://aio.tipsindex.net/",
  "description": "AIO/LLMOの実務手順を実際に試し、結果を記録する個人メディア",
  "founder": {
    "@type": "Person",
    "name": "asatrid"
  }
};

// 新しい記事を追加するときは、この配列に1件追加するだけでトップページに反映される
const articles = [
  {
    title: "AIOとLLMOとGEOとAEO、結局どう違うのか",
    slug: "/articles/aio-llmo-difference/",
    date: "2026-08-07",
    excerpt: "AIO/LLMO/GEO/AEOという用語の包含関係を複数の情報源で比較すると、定義が一致しないことがわかる。業界で標準化されていない現状を、出典付きで整理する。",
  },
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---
<BaseLayout
  title="AIO Field Notes — AIO/LLMO実践記録"
  description="AIO(AI最適化)・LLMO(大規模言語モデル最適化)の実務手順を、実際に手を動かして試し、ChatGPT/Gemini/Perplexity/Claudeでの引用・言及状況を記録していく個人メディアです。"
  jsonLd={jsonLd}
>
  <p class="eyebrow">AIO / LLMO Field Notes</p>
  <h1 class="hero-title">AIO/LLMO実践記録</h1>
  <p>
    AIO Field Notesは、AIO(AI Optimization)・LLMO(Large Language Model Optimization)と呼ばれる
    分野の実務手順を、実際に自分の手で試して記録するための個人メディアです。
  </p>
  <p>
    <strong>方針:</strong> 断定的な効果を保証する情報発信はせず、一次情報・公式仕様・実際の計測結果に
    基づいた記録のみを公開します。業界内で用語の定義が統一されていない点も、そのまま正直に書きます。
  </p>

  <h2>Latest Article <span class="h2-sub">最新の記事</span></h2>
  <div class="article-list">
    {articles.map((a) => (
      <a href={a.slug} class="article-card">
        <span class="article-date">{a.date}</span>
        <span class="article-title">{a.title}</span>
        <span class="article-excerpt">{a.excerpt}</span>
      </a>
    ))}
  </div>

  <div class="terms-box">
    <h3 class="terms-heading">用語の整理 <span class="h2-sub">Terms</span></h3>
    <p>
      AIO・LLMO・GEO・AEOは、業界で定義が統一されていない用語です。以下は現時点で
      比較的よく参照される整理の一例で、唯一の正解ではありません。詳しい経緯と複数の説の比較は
      <a href="/articles/aio-llmo-difference/">こちらの記事</a>にまとめています。
    </p>
    <table>
      <thead>
        <tr>
          <th>用語</th>
          <th>正式名称</th>
          <th>主な対象</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>SEO</td>
          <td>Search Engine Optimization</td>
          <td>検索エンジンの検索結果</td>
        </tr>
        <tr>
          <td>AIO</td>
          <td>AI Optimization <br />/ AI Overview Optimization</td>
          <td>AI検索全般、またはGoogle AI Overview限定(情報源により定義が異なる)</td>
        </tr>
        <tr>
          <td>LLMO</td>
          <td>Large Language Model Optimization</td>
          <td>ChatGPT/Claude等の大規模言語モデル</td>
        </tr>
        <tr>
          <td>GEO</td>
          <td>Generative Engine Optimization</td>
          <td>生成AI搭載検索エンジン全般</td>
        </tr>
        <tr>
          <td>AEO</td>
          <td>Answer Engine Optimization</td>
          <td>回答エンジン全般(ChatGPT/Perplexity/Gemini等)</td>
        </tr>
      </tbody>
      <caption>
        出典: <a href="https://note.com/frank_pr/n/n6b2d214d3ed2" target="
